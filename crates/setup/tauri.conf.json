{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phase Setup",
  "mainBinaryName": "phase-setup",
  "identifier": "app.phase.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Phase",
    "copyright": "Phase",
    "shortDescription": "Установка Phase",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
